<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Vigilance Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- No APP_KEY here on purpose. Testbench sets its own when the env has
             none, so a base64-shaped string in a public repo bought us nothing
             but a recurring secret-scanner alert. -->
        <env name="DB_CONNECTION" value="testing"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Testbench's skeleton .env defaults the cache to the database store,
             whose table the in-memory testing connection never migrates. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
